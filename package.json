{
  "name": "@gcoward/custom-elements",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "overrides": { "minimatch": "11.0.4" },
  "workspaces": [
    "demo"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/custom-elements.js"
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace demo",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:demo": "npm run build && npm run build --workspace demo",
    "lint": "tsc --noEmit && npm run lint --workspace demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
